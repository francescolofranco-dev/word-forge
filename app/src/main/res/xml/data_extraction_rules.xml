<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep retired data out of backups until startup cleanup runs. -->
        <exclude domain="sharedpref" path="wordforge_llm_credentials.xml" />
        <exclude domain="sharedpref" path="wordforge_llm_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wordforge_llm_credentials.xml" />
        <exclude domain="sharedpref" path="wordforge_llm_settings.xml" />
    </device-transfer>
</data-extraction-rules>
